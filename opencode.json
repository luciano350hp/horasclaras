{
  "$schema": "https://opencode.ai/config.json",
  "default_agent": "build",
  "mcp": {
    "context7": {
      "enabled": true,
      "type": "remote",
      "url": "https://mcp.context7.com/mcp"
    },
    "engram": {
      "command": [
        "engram",
        "mcp",
        "--tools=agent"
      ],
      "type": "local"
    },
    "filesystem": {
      "command": [
        "cmd",
        "/c",
        "npx",
        "-y",
        "@modelcontextprotocol/server-filesystem",
        "C:\\Users\\Napo\\Documents\\HorasClaras"
      ],
      "enabled": true,
      "type": "local"
    }
  },
  "share": "disabled"
}